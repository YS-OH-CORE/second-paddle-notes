{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YS-OH-CORE/second-paddle-notes/rule-use-case.schema.json",
  "title": "Rule-use smoke case",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "task_content"],
  "properties": {
    "case_id": {
      "type": "string",
      "pattern": "^RUE-[A-F0-9]{12}$"
    },
    "task_content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instruction",
        "observed_event",
        "rules",
        "trigger_examples",
        "action_checks",
        "verification_statement",
        "links"
      ],
      "properties": {
        "instruction": {"type": "string"},
        "observed_event": {"type": "string"},
        "rules": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_id", "text"],
            "properties": {
              "rule_id": {"type": "string"},
              "text": {"type": "string"}
            }
          }
        },
        "trigger_examples": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["trigger_id", "example"],
            "properties": {
              "trigger_id": {"type": "string"},
              "example": {"type": "string"}
            }
          }
        },
        "action_checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["action_id", "check"],
            "properties": {
              "action_id": {"type": "string"},
              "check": {"type": "string"}
            }
          }
        },
        "verification_statement": {"type": "string"},
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["direction", "rule_id", "trigger_id", "action_id"],
            "properties": {
              "direction": {"enum": ["rule_to_trigger_to_action", "action_to_trigger_to_rule"]},
              "rule_id": {"type": "string"},
              "trigger_id": {"type": "string"},
              "action_id": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
