{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YS-OH-CORE/second-paddle-notes/rule-use-prediction.schema.json",
  "title": "Rule-use smoke prediction",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "action"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^RUE-[A-F0-9]{12}$"},
    "action": {"type": "string", "minLength": 1}
  }
}
