{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/YS-OH-CORE/second-paddle-notes/rule-use-gold.schema.json",
  "title": "Rule-use smoke gold record",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "template_id", "scope", "condition", "expected_action"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^RUE-[A-F0-9]{12}$"},
    "template_id": {"enum": ["facility", "data", "support", "factory"]},
    "scope": {"enum": ["relevant", "irrelevant"]},
    "condition": {"enum": ["correct", "shuffled", "reversed", "absent", "irrelevant_probe"]},
    "expected_action": {"type": "string"}
  }
}
