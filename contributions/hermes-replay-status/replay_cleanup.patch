+"""Do not turn text inside successful JSON results into interrupt state.
+
+These are synthetic regression cases, not model or gateway evaluations.
+"""
+import copy
+import json
+
+import pytest
+
+from agent.replay_cleanup import is_interrupted_tool_result, sanitize_replay_history
+from agent.tool_dispatch_helpers import make_tool_result_message
+
+
+@pytest.mark.parametrize("payload, expected", [
+    pytest.param({"output": "done", "exit_code": 0}, False, id="ordinary_success"),
+    pytest.param({"output": "Docs: [Command interrupted] is a marker.", "exit_code": 0}, False, id="success_quotes_marker"),
+    pytest.param({"output": "The docs explain interrupt exit_code 130.", "exit_code": 0}, False, id="success_quotes_code"),
+    pytest.param({"output": "interrupt documentation, example 1300", "exit_code": 0}, False, id="unrelated_digits"),
+    pytest.param({"content": "Docs: [Command interrupted] is a marker."}, False, id="document_without_status"),
+    pytest.param({"output": "Docs: [Command interrupted]", "exit_code": 1}, False, id="different_failure"),
+    pytest.param({"output": "Docs: [Command interrupted]", "exit_code": 124}, False, id="timeout_not_interrupt"),
+    pytest.param({"output": "interrupt", "exit_code": 1300}, False, id="code_is_not_substring"),
+    pytest.param({"output": "interrupt", "exit_code": -10}, False, id="negative_code_is_not_substring"),
+    pytest.param({"output": "[Command interrupted]", "exit_code": "130"}, False, id="status_requires_integer"),
+    pytest.param({"output": "[Command interrupted]", "exit_code": None}, False, id="null_is_not_status"),
+    pytest.param({"output": "[Command interrupted]", "exit_code": False}, False, id="boolean_is_not_status"),
+    pytest.param({"output": "finished", "exit_code": 130}, False, id="self_returned_130"),
+    pytest.param({"output": "partial output\n[Command interrupted]", "exit_code": 130, "error": None}, True, id="actual_130_marker"),
+    pytest.param({"output": "Command was interrupted", "exit_code": -1}, True, id="legacy_negative_one"),
+    pytest.param({"output": None, "error": "interrupted", "exit_code": 130}, True, id="error_field_interrupt"),
+    pytest.param({"output": "done", "exit_code": 0, "example": {"output": "[Command interrupted]", "exit_code": 130}}, False, id="nested_example_is_not_status"),
+    pytest.param(["[Command interrupted]"], False, id="json_list_is_data"),
+    pytest.param("[Command interrupted]", False, id="json_string_is_data"),
+])
+def test_structured_interrupt_classification(payload, expected):
+    assert is_interrupted_tool_result(json.dumps(payload)) is expected
+
+
+@pytest.mark.parametrize("content, expected", [
+    pytest.param("[Command interrupted]", True, id="raw_marker"),
+    pytest.param("exit_code=-1: command interrupted", True, id="legacy_unstructured"),
+    pytest.param("done", False, id="raw_success"),
+    pytest.param(None, False, id="none"),
+    pytest.param({"exit_code": 130, "output": "[Command interrupted]"}, False, id="non_string_contract"),
+])
+def test_legacy_input_contract_unchanged(content, expected):
+    assert is_interrupted_tool_result(content) is expected
+
+
+def _history(name, payload):
+    return [
+        {"role": "user", "content": "Read the documentation."},
+        {"role": "assistant", "content": "", "tool_calls": [
+            {"id": "c1", "type": "function", "function": {"name": name, "arguments": "{}"}}
+        ]},
+        make_tool_result_message(name, json.dumps(payload), "c1"),
+        {"role": "user", "content": "Explain that result; do not rerun it."},
+    ]
+
+
+@pytest.mark.parametrize("name, payload", [
+    ("terminal", {"output": "Docs explain interrupt exit_code 130.", "exit_code": 0}),
+    ("read_file", {"content": "The literal [Command interrupted] is documented here."}),
+])
+def test_success_survives_real_message_builder_and_replay(name, payload):
+    history = _history(name, payload)
+    original = copy.deepcopy(history)
+    replay = sanitize_replay_history(history)
+    assert history == original
+    assert replay == original
+    assert replay[-1]["content"] == "Explain that result; do not rerun it."
+
+
+def test_real_interrupt_still_gets_unknown_effect_recovery():
+    history = _history("terminal", {"output": "[Command interrupted]", "exit_code": 130})
+    original = copy.deepcopy(history)
+    replay = sanitize_replay_history(history)
+    assert history == original
+    assert len(replay) == 4
+    assert replay[2]["effect_disposition"] == "unknown"
+    assert "UNKNOWN" in replay[2]["content"]
+    assert replay[-1] == original[-1]
