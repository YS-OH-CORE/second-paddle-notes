{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/second-paddle/receipt-contract/v1",
  "title": "Recoverable effect receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "operation_id", "request_digest", "status", "result", "committed_at"],
  "properties": {
    "contract_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 16, "maxLength": 256},
    "request_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"const": "committed"},
    "result": {},
    "committed_at": {"type": "string", "minLength": 1, "maxLength": 256}
  }
}
